{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "paths": {
      "*": ["*", "*.ts"]
    },
    "moduleSuffixes": [".ts", ".js"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", ".next", "app", "**/*.test.ts", "**/*.test.tsx", "jest.setup.ts"]
}

